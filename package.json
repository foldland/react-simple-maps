{
  "name": "@foldland/react-simple-maps",
  "version": "4.0.4",
  "description": "An svg map chart component built with and for React",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/react-simple-maps.umd.cjs",
  "module": "./dist/react-simple-maps.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/react-simple-maps.js",
      "require": "./dist/react-simple-maps.umd.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "check": "pnpm format:check && pnpm lint:check && pnpm typecheck",
    "dev": "vite",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false ",
    "format:write": "biome format --write",
    "link": "directus-extension link",
    "lint:check": "biome check --formatter-enabled=false --linter-enabled=true --assist-enabled=true",
    "lint:write": "pnpm lint:check --write",
    "preview": "vite preview",
    "test": "",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0",
    "react-dom": "^19.0"
  },
  "dependencies": {
    "d3-color": "^3.1.0",
    "d3-geo": "^3.1.1",
    "d3-interpolate": "^3.0.1",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@foldland/biome-configs": "1.1.5",
    "@types/d3-color": "3.1.3",
    "@types/d3-geo": "3.1.0",
    "@types/d3-interpolate": "3.0.4",
    "@types/d3-selection": "3.0.11",
    "@types/d3-zoom": "3.0.8",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "@vitejs/plugin-react-swc": "4.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "6.0.3",
    "vite": "8.0.10",
    "vite-plugin-dts": "5.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.0.9",
      "onFail": "download"
    }
  }
}
